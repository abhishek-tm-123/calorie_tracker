# ===================== accounts ===========================
#api call for creating auser
###
POST http://127.0.0.1:8000/accounts/register/
Content-Type: application/json

{
    "username":"abinandha",
    "password":"abinandha@123",
    "phone":"9497328661",
    "height":172,
    "weight":61,
    "dob":"2005-12-07"
}

# ======================= Food Entries ===========================
#api call for listing all food entries
###
GET http://127.0.0.1:8000/foods/
Accept: application/json
Authorization: Basic abhishek:abhishek@123

#api call for creating a food_entry
###
POST http://127.0.0.1:8000/foods/
Content-Type: application/json
Authorization: Basic abhishek:abhishek@123

{
    "title":"biriyani",
    "serving_size":"200 gm",
    "calorie":400,
    "meal_type":"lunch"
    
}

#api call for retrieving a foodlog
###
GET http://127.0.0.1:8000/foods/1/
Accept: application/json
Authorization: Basic abinandha:abinandha@123

#api call for updating a foodlog
###
PUT http://127.0.0.1:8000/foods/1/
Content-Type: application/json
Authorization: Basic abhishek:abhishek@123

{
  "id": 1,
  "title": "biriyani",
  "serving_size": "200 gm",
  "calorie": 450.0,
  "meal_type": "lunch",
  "food_image": null,
  "created_at": "2026-11-12T15:15:46.676045Z",
  "owner": 1
}

#api call for deleting a foodlog
###
DELETE http://127.0.0.1:8000/foods/1/
Accept: application/json
Authorization: Basic abhishek:abhishek@123